clc;
clear;
close all;

%% -------------------- Signal Generation --------------------
fs = 1000;                 % Sampling frequency (Hz)
f  = 50;                   % Signal frequency (Hz)
t  = 0:1/fs:0.1;           % Time vector

x = sin(2*pi*f*t);          % Original sinusoidal signal

%% -------------------- Quantization Parameters --------------------
L = [8 16 32];              % Quantization levels
colors = {'r','g','m'};     % Plot colors

%% -------------------- Quantization and Error Calculation --------------------
figure;

for i = 1:length(L)

    % Quantization
    xq{i} = round((x + 1) * (L(i)-1) / 2) ...
            * (2 / (L(i)-1)) - 1;

    % Quantization error
    e{i} = x - xq{i};

    % Mean Squared Error
    mse(i) = mean(e{i}.^2);

    % Plot quantized signal
    subplot(4,1,i+1);
    stairs(t, xq{i}, colors{i}, 'LineWidth', 1.2);
    title(['Quantized Signal (' num2str(L(i)) ' Levels)']);
    xlabel('Time (s)');
    ylabel('Amplitude');
    grid on;

end

%% -------------------- Original Signal --------------------
subplot(4,1,1);
plot(t, x, 'LineWidth', 1.5);
title('Original Signal');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;

%% -------------------- Display MSE --------------------
fprintf('MSE for 8 Levels  = %f\n', mse(1));
fprintf('MSE for 16 Levels = %f\n', mse(2));
fprintf('MSE for 32 Levels = %f\n', mse(3));

%% -------------------- Quantization Error Plots --------------------
figure;

for i = 1:3
    subplot(3,1,i);
    plot(t, e{i}, 'LineWidth', 1.2);
    title(['Quantization Error (' num2str(L(i)) ' Levels)']);
    xlabel('Time (s)');
    ylabel('Error');
    grid on;
end
